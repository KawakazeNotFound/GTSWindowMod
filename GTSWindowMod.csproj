<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GTSWindowMod</AssemblyName>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(ReferenceRoot)' != ''">
    <Reference Include="0Harmony"><HintPath>$(ReferenceRoot)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(ReferenceRoot)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ReferenceRoot)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ReferenceRoot)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(ReferenceRoot)' == ''">
    <PackageReference Include="BepInEx.Core" Version="[5.4.21]" PrivateAssets="all" />
    <PackageReference Include="HarmonyX" Version="[2.9.0]" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="[2019.4.28]" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="[1.0.3]" PrivateAssets="all" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
</Project>
